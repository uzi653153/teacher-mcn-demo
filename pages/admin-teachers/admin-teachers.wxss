.page {
  padding: 0 24rpx 60rpx;
}

.head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding: 34rpx 8rpx 24rpx;
}

.head-title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
}

.head-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--text-3);
}

.add-btn {
  padding: 12rpx 28rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #ffffff;
  background: linear-gradient(135deg, #2b4acb, #5b7cfa);
  border-radius: 999rpx;
  box-shadow: 0 10rpx 22rpx rgba(43, 74, 203, 0.24);
}

.item {
  margin-bottom: 20rpx;
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(26, 34, 51, 0.05);
  overflow: hidden;
}

.item-main {
  display: flex;
  align-items: center;
  padding: 26rpx 26rpx 20rpx;
}

.avatar {
  width: 96rpx;
  height: 96rpx;
  flex-shrink: 0;
  border-radius: 26rpx;
}

.avatar--fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: 700;
  color: #ffffff;
  background: linear-gradient(135deg, #2b4acb, #5b7cfa);
}

.avatar--large {
  width: 128rpx;
  height: 128rpx;
  border-radius: 32rpx;
}

.info {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}

.name-line {
  display: flex;
  align-items: center;
}

.name {
  max-width: 260rpx;
  font-size: 30rpx;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.status {
  margin-left: 12rpx;
  padding: 3rpx 12rpx;
  font-size: 18rpx;
  border-radius: 999rpx;
}

.status--on {
  color: var(--success);
  background: #ecfdf3;
}

.status--off {
  color: var(--text-3);
  background: #f2f4f7;
}

.sub {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--text-2);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tags {
  display: block;
  margin-top: 6rpx;
  font-size: 21rpx;
  color: var(--text-3);
}

.arrow {
  font-size: 40rpx;
  color: var(--text-3);
}

.item-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 26rpx 20rpx;
  border-top: 1rpx solid var(--line);
}

.edit-link {
  font-size: 23rpx;
  color: var(--brand);
}

.toggle {
  padding: 8rpx 26rpx;
  font-size: 22rpx;
  border-radius: 999rpx;
}

.toggle--off {
  color: var(--danger);
  background: #fef3f2;
}

.toggle--on {
  color: var(--success);
  background: #ecfdf3;
}

.loading {
  padding: 50rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: var(--text-3);
}

/* 表单弹层 */
.mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 20;
  background: rgba(16, 24, 40, 0.48);
}

.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 21;
  max-height: 88vh;
  background: #ffffff;
  border-radius: 36rpx 36rpx 0 0;
  overflow: hidden;
}

.sheet-body {
  max-height: 88vh;
  padding: 32rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.sheet-title {
  font-size: 34rpx;
  font-weight: 700;
}

.sheet-close {
  font-size: 24rpx;
  color: var(--text-3);
}

.avatar-row {
  display: flex;
  align-items: center;
  margin-top: 28rpx;
}

.avatar-actions {
  margin-left: 24rpx;
}

.upload-btn {
  display: inline-block;
  padding: 12rpx 30rpx;
  font-size: 23rpx;
  color: var(--brand);
  background: var(--brand-light);
  border-radius: 999rpx;
}

.avatar-tip {
  display: block;
  margin-top: 10rpx;
  font-size: 20rpx;
  color: var(--text-3);
}

.field {
  margin-top: 24rpx;
}

.field-row {
  display: flex;
  gap: 20rpx;
}

.field--half {
  flex: 1;
  min-width: 0;
}

.label {
  display: block;
  margin-bottom: 10rpx;
  font-size: 23rpx;
  color: var(--text-2);
}

.input,
.picker,
.textarea {
  width: 100%;
  padding: 18rpx 22rpx;
  font-size: 25rpx;
  color: var(--text-1);
  background: #f7f8fb;
  border: 1rpx solid #eef1f6;
  border-radius: 16rpx;
  box-sizing: border-box;
}

.picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.picker-arrow {
  font-size: 20rpx;
  color: var(--text-3);
}

.textarea {
  height: 168rpx;
  line-height: 1.6;
}

.switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 28rpx;
  padding: 20rpx 22rpx;
  background: #f7f8fb;
  border-radius: 16rpx;
}

.switch-label {
  display: block;
  font-size: 25rpx;
  font-weight: 600;
}

.switch-sub {
  display: block;
  margin-top: 4rpx;
  font-size: 20rpx;
  color: var(--text-3);
}

.sheet-foot {
  display: flex;
  gap: 20rpx;
  margin-top: 32rpx;
}

.btn {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 999rpx;
}

.btn--ghost {
  color: var(--text-2);
  background: #f2f4f7;
}

.btn--primary {
  color: #ffffff;
  background: linear-gradient(135deg, #2b4acb, #5b7cfa);
  box-shadow: 0 10rpx 22rpx rgba(43, 74, 203, 0.24);
}
