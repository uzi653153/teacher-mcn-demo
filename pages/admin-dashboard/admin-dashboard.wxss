.page {
  padding: 0 24rpx 60rpx;
}

.head {
  padding: 34rpx 8rpx 24rpx;
}

.head-title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
}

.head-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 23rpx;
  color: var(--text-3);
}

.stats {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.stat {
  width: calc(50% - 10rpx);
  margin-bottom: 20rpx;
  padding: 28rpx;
  color: #ffffff;
  border-radius: 24rpx;
  box-sizing: border-box;
}

.stat--brand {
  background: linear-gradient(135deg, #2b4acb, #5b7cfa);
}

.stat--warn {
  background: linear-gradient(135deg, #f79009, #fdb022);
}

.stat--green {
  background: linear-gradient(135deg, #12b76a, #32d583);
}

.stat--purple {
  background: linear-gradient(135deg, #7a5af8, #a48afb);
}

.stat-value {
  display: block;
  font-size: 50rpx;
  font-weight: 700;
  line-height: 1.1;
}

.stat-label {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  opacity: 0.86;
}

.block {
  margin-top: 8rpx;
  margin-bottom: 22rpx;
  padding: 28rpx;
  background: #ffffff;
  border-radius: 26rpx;
  box-shadow: 0 8rpx 24rpx rgba(26, 34, 51, 0.05);
}

.block-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.block-title {
  font-size: 29rpx;
  font-weight: 700;
}

.block-extra {
  font-size: 21rpx;
  color: var(--text-3);
}

.chart {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  height: 320rpx;
  margin-top: 26rpx;
}

.bar-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  height: 100%;
}

.bar-count {
  font-size: 19rpx;
  color: var(--text-3);
  line-height: 1.2;
}

.bar-track {
  flex: 1;
  display: flex;
  align-items: flex-end;
  width: 100%;
  padding: 8rpx 10rpx;
  box-sizing: border-box;
}

.bar {
  width: 100%;
  min-height: 8rpx;
  background: #dbe3fb;
  border-radius: 10rpx 10rpx 4rpx 4rpx;
  transition: height 0.4s ease;
}

.bar--today {
  background: linear-gradient(180deg, #5b7cfa, #2b4acb);
}

.bar-label {
  margin-top: 8rpx;
  font-size: 19rpx;
  color: var(--text-3);
}

.bar-label--today {
  color: var(--brand);
  font-weight: 600;
}

.rank {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.rank:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.rank-no {
  width: 40rpx;
  height: 40rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: var(--text-3);
  text-align: center;
  line-height: 40rpx;
  background: #f2f4f7;
  border-radius: 12rpx;
}

.rank-no--1 {
  color: #ffffff;
  background: #f79009;
}

.rank-no--2 {
  color: #ffffff;
  background: #98a2b3;
}

.rank-no--3 {
  color: #ffffff;
  background: #b54708;
}

.rank-info {
  flex: 1;
  margin-left: 18rpx;
}

.rank-name {
  display: block;
  font-size: 27rpx;
  font-weight: 600;
}

.rank-sub {
  display: block;
  margin-top: 4rpx;
  font-size: 21rpx;
  color: var(--text-3);
}

.rank-fans {
  font-size: 22rpx;
  color: var(--text-3);
}

.quick {
  display: flex;
  justify-content: space-between;
  margin-top: 8rpx;
}

.quick-item {
  width: calc(33.33% - 12rpx);
  padding: 28rpx 0;
  text-align: center;
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(26, 34, 51, 0.05);
}

.quick-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  margin: 0 auto;
  font-size: 26rpx;
  font-weight: 600;
  border-radius: 20rpx;
}

.quick-icon--brand {
  color: var(--brand);
  background: var(--brand-light);
}

.quick-icon--purple {
  color: #7a5af8;
  background: #f4f0ff;
}

.quick-icon--green {
  color: var(--success);
  background: #ecfdf3;
}

.quick-text {
  display: block;
  margin-top: 10rpx;
  font-size: 23rpx;
  color: var(--text-2);
}
