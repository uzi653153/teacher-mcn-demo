<!--booking.wxml-->
<view class="page" wx:if="{{success}}">
  <view class="success">
    <view class="success-icon">
      <view class="success-check"></view>
    </view>
    <text class="success-title">预约成功</text>
    <text class="success-desc">
      已收到你对 {{bookedTeacher}} 的预约，我们会在 1 个工作日内与你联系。
    </text>
    <button class="btn-primary success-btn" hover-class="btn-primary--hover" bindtap="onViewBookings">
      查看我的预约
    </button>
    <view class="success-link" bindtap="onBookAnother">再约一位老师</view>
  </view>
</view>

<view class="page" wx:else>
  <view class="intro-card">
    <text class="intro-title">
      预约{{selectedTeacherName || '意向名师'}}
    </text>
    <text class="intro-sub">提交后，老师团队会在 1 个工作日内与你联系</text>
  </view>

  <view class="form-card">
    <view class="field">
      <text class="label">学生姓名</text>
      <input
        class="input {{errors.name ? 'input--error' : ''}}"
        value="{{form.name}}"
        placeholder="请输入学生姓名"
        placeholder-class="ph"
        maxlength="20"
        bindinput="onNameInput"
      />
      <text class="error" wx:if="{{errors.name}}">{{errors.name}}</text>
    </view>

    <view class="field">
      <text class="label">手机号</text>
      <input
        class="input {{errors.phone ? 'input--error' : ''}}"
        type="number"
        value="{{form.phone}}"
        placeholder="用于老师团队联系你"
        placeholder-class="ph"
        maxlength="11"
        bindinput="onPhoneInput"
      />
      <text class="error" wx:if="{{errors.phone}}">{{errors.phone}}</text>
    </view>

    <view class="field">
      <text class="label">意向名师</text>
      <picker
        mode="selector"
        range="{{teacherNames}}"
        value="{{teacherIndex}}"
        bindchange="onTeacherChange"
      >
        <view class="picker {{teacherIndex < 0 ? 'picker--empty' : ''}}">
          <text>{{selectedTeacherName || '请选择意向名师'}}</text>
          <text class="picker-arrow">›</text>
        </view>
      </picker>
      <text class="error" wx:if="{{errors.teacher}}">{{errors.teacher}}</text>
    </view>

    <view class="field">
      <text class="label">学生学段</text>
      <picker mode="selector" range="{{stages}}" value="{{stageIndex}}" bindchange="onStageChange">
        <view class="picker">
          <text>{{stages[stageIndex]}}</text>
          <text class="picker-arrow">›</text>
        </view>
      </picker>
    </view>

    <view class="field field--last">
      <text class="label">备注</text>
      <textarea
        class="textarea"
        value="{{form.remark}}"
        placeholder="想咨询的课程、时间等（选填）"
        placeholder-class="ph"
        maxlength="200"
        bindinput="onRemarkInput"
      />
      <text class="counter">{{form.remark.length}}/200</text>
    </view>
  </view>

  <view class="tips">提交即表示同意我们通过电话与你联系，信息仅用于本次预约。</view>

  <view class="teacher-error" wx:if="{{teacherLoadError}}">
    {{teacherLoadError}}
    <text class="retry" bindtap="fetchTeachers">重试</text>
  </view>

  <button
    class="btn-primary submit-btn"
    disabled="{{submitting}}"
    hover-class="btn-primary--hover"
    bindtap="onSubmit"
  >
    {{submitting ? '提交中...' : '提交预约'}}
  </button>
</view>
