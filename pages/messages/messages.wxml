<view class="page">
  <view class="head">
    <view class="head-info">
      <text class="head-title">消息中心</text>
      <text class="head-sub">{{unread > 0 ? unread + ' 条未读消息' : '暂无未读消息'}}</text>
    </view>
    <view class="read-all {{unread > 0 ? '' : 'read-all--disabled'}}" bindtap="onReadAll">全部已读</view>
  </view>

  <view class="list" wx:if="{{!error}}">
    <view
      class="item {{item.isRead ? 'item--read' : ''}}"
      wx:for="{{list}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="onTapItem"
    >
      <view class="dot" wx:if="{{!item.isRead}}"></view>
      <view class="item-top">
        <view class="type {{item.typeClass}}">{{item.typeText}}</view>
        <text class="time">{{item.timeText}}</text>
      </view>
      <text class="title">{{item.title}}</text>
      <text class="content">{{item.content}}</text>
    </view>

    <view class="loading" wx:if="{{loading}}">加载中...</view>
    <view class="loading" wx:if="{{loadingMore}}">加载更多...</view>
    <view class="end" wx:if="{{!loading && !hasMore && list.length > 0}}">没有更多消息了</view>
  </view>

  <empty-state
    wx:if="{{error}}"
    title="消息加载失败"
    desc="{{error}}"
    action-text="重新加载"
    bindaction="onRetry"
  />
  <empty-state
    wx:elif="{{!loading && list.length === 0}}"
    title="暂无消息"
    desc="预约进度、直播提醒都会出现在这里"
  />
</view>
