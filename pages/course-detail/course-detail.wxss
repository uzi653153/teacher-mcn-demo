.page {
  padding: 0 24rpx 200rpx;
}

.hero {
  position: relative;
  margin: 0 -24rpx;
  padding: 34rpx 48rpx 40rpx;
  overflow: hidden;
  color: #ffffff;
  background: linear-gradient(140deg, #1e2a4a 0%, #2b4acb 62%, #7a5af8 100%);
  border-radius: 0 0 44rpx 44rpx;
}

.hero-glow {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.1);
}

.hero-glow--1 {
  top: -140rpx;
  right: -90rpx;
  width: 320rpx;
  height: 320rpx;
}

.hero-glow--2 {
  bottom: -120rpx;
  left: -80rpx;
  width: 240rpx;
  height: 240rpx;
}

.hero-top {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.status {
  padding: 6rpx 20rpx;
  font-size: 21rpx;
  font-weight: 600;
  border-radius: 999rpx;
}

.course-status--upcoming {
  color: #ffffff;
  background: rgba(255, 255, 255, 0.2);
}

.course-status--live {
  color: #ffffff;
  background: #f04438;
}

.course-status--ended {
  color: #5b6475;
  background: rgba(255, 255, 255, 0.85);
}

.platform {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.7);
}

.hero-title {
  position: relative;
  z-index: 1;
  display: block;
  margin-top: 26rpx;
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.35;
}

.hero-meta {
  position: relative;
  z-index: 1;
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.76);
}

.facts {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  margin-top: 32rpx;
  padding: 22rpx 0;
  background: rgba(255, 255, 255, 0.14);
  border-radius: 22rpx;
}

.fact {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.fact-value {
  font-size: 28rpx;
  font-weight: 600;
}

.fact-label {
  margin-top: 6rpx;
  font-size: 19rpx;
  color: rgba(255, 255, 255, 0.66);
}

.fact-line {
  width: 1rpx;
  height: 44rpx;
  background: rgba(255, 255, 255, 0.18);
}

.progress-card {
  margin-top: 24rpx;
  padding: 26rpx 28rpx;
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(26, 34, 51, 0.05);
}

.progress-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.progress-title {
  font-size: 25rpx;
  font-weight: 600;
}

.progress-percent {
  font-size: 23rpx;
  color: var(--brand);
}

.progress-track {
  height: 12rpx;
  margin-top: 16rpx;
  overflow: hidden;
  background: #eef1f6;
  border-radius: 999rpx;
}

.progress-bar {
  height: 100%;
  background: linear-gradient(90deg, #2b4acb, #7a5af8);
  border-radius: 999rpx;
}

.card {
  margin-top: 22rpx;
  padding: 28rpx;
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(26, 34, 51, 0.05);
}

.teacher-card {
  display: flex;
  align-items: center;
}

.teacher-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: #ffffff;
  background: linear-gradient(135deg, #2b4acb, #5b7cfa);
  border-radius: 26rpx;
}

.teacher-info {
  flex: 1;
  margin-left: 20rpx;
}

.teacher-name {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
}

.teacher-sub {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--text-3);
}

.teacher-arrow {
  font-size: 40rpx;
  color: var(--text-3);
}

.section-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
}

.intro {
  display: block;
  margin-top: 16rpx;
  font-size: 26rpx;
  line-height: 1.8;
  color: var(--text-2);
}

.tip-line {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: var(--text-2);
}

.more {
  margin-top: 28rpx;
  padding: 22rpx 0;
  text-align: center;
  font-size: 25rpx;
  color: var(--brand);
  background: #ffffff;
  border-radius: 999rpx;
}

.action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 18rpx 32rpx calc(18rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 -8rpx 24rpx rgba(26, 34, 51, 0.06);
}

.action-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #ffffff;
  background: linear-gradient(135deg, #2b4acb, #5b7cfa);
  border-radius: 999rpx;
  box-shadow: 0 12rpx 26rpx rgba(43, 74, 203, 0.26);
}

.action-btn--cancel {
  color: var(--text-2);
  background: #f2f4f7;
  box-shadow: none;
}

.action-btn--disabled {
  color: var(--text-3);
  background: #f2f4f7;
  box-shadow: none;
}

.loading {
  padding: 140rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: var(--text-3);
}
