/**index.wxss**/
.page {
  padding: 0 24rpx 60rpx;
}

/* 顶部品牌区 */
.hero {
  position: relative;
  margin: 0 -24rpx;
  padding: 36rpx 48rpx 104rpx;
  overflow: hidden;
  color: #ffffff;
  background: linear-gradient(140deg, #2b4acb 0%, #4b6bfb 58%, #7a5af8 100%);
  border-radius: 0 0 48rpx 48rpx;
}

.hero-glow {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.12);
}

.hero-glow--1 {
  top: -140rpx;
  right: -90rpx;
  width: 340rpx;
  height: 340rpx;
}

.hero-glow--2 {
  bottom: -120rpx;
  left: -70rpx;
  width: 240rpx;
  height: 240rpx;
  background: rgba(255, 255, 255, 0.08);
}

.hero-top {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.hero-badge {
  padding: 6rpx 18rpx;
  font-size: 20rpx;
  letter-spacing: 2rpx;
  background: rgba(255, 255, 255, 0.18);
  border-radius: 999rpx;
}

.hero-slogan {
  font-size: 22rpx;
  letter-spacing: 4rpx;
  color: rgba(255, 255, 255, 0.78);
}

.hero-title {
  position: relative;
  z-index: 1;
  display: block;
  margin-top: 28rpx;
  font-size: 56rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.hero-sub {
  position: relative;
  z-index: 1;
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.82);
}

.hero-stats {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  margin-top: 36rpx;
}

.hero-stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.hero-stat-value {
  font-size: 34rpx;
  font-weight: 700;
}

.hero-stat-label {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.7);
}

.hero-stat-line {
  width: 1rpx;
  height: 48rpx;
  background: rgba(255, 255, 255, 0.2);
}

/* 搜索 */
.search-wrap {
  position: relative;
  z-index: 2;
  margin-top: -52rpx;
  padding: 0 8rpx;
}

.search {
  display: flex;
  align-items: center;
  height: 96rpx;
  padding: 0 28rpx;
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 12rpx 32rpx rgba(26, 34, 51, 0.1);
}

.search-icon {
  position: relative;
  width: 30rpx;
  height: 30rpx;
  margin-right: 18rpx;
  border: 3rpx solid #98a2b3;
  border-radius: 50%;
}

.search-icon::after {
  content: '';
  position: absolute;
  right: -10rpx;
  bottom: -6rpx;
  width: 14rpx;
  height: 3rpx;
  background: #98a2b3;
  border-radius: 2rpx;
  transform: rotate(45deg);
}

.search-input {
  flex: 1;
  font-size: 27rpx;
  color: var(--text);
}

.search-placeholder {
  color: #a6b1c2;
}

.search-clear {
  width: 44rpx;
  height: 44rpx;
  line-height: 40rpx;
  text-align: center;
  font-size: 34rpx;
  color: #98a2b3;
}

/* 搜索热词 */
.hot {
  margin: 22rpx 8rpx 0;
}

.hot-row {
  display: flex;
  align-items: flex-start;
  margin-bottom: 14rpx;
}

.hot-label {
  flex-shrink: 0;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--text-3);
}

.hot-tags {
  display: flex;
  flex-wrap: wrap;
  margin-left: 16rpx;
}

.hot-tag {
  padding: 8rpx 22rpx;
  margin: 0 12rpx 12rpx 0;
  font-size: 22rpx;
  color: var(--brand);
  background: var(--brand-light);
  border-radius: 999rpx;
}

.hot-tag--history {
  color: var(--text-2);
  background: #ffffff;
  border: 1rpx solid var(--line);
}

/* 直播预告卡片 */
.live-card {
  display: flex;
  align-items: stretch;
  margin-top: 18rpx;
  overflow: hidden;
  background: linear-gradient(135deg, #1e2a4a, #2b4acb);
  border-radius: 24rpx;
  box-shadow: 0 12rpx 28rpx rgba(30, 42, 74, 0.24);
}

.live-main {
  flex: 1;
  padding: 24rpx 26rpx;
  min-width: 0;
}

.live-head {
  display: flex;
  align-items: center;
}

.live-badge {
  display: flex;
  align-items: center;
  padding: 4rpx 16rpx;
  font-size: 20rpx;
  color: #ffffff;
  background: rgba(255, 255, 255, 0.18);
  border-radius: 999rpx;
}

.live-badge--live {
  background: #f04438;
}

.live-dot {
  width: 10rpx;
  height: 10rpx;
  margin-right: 8rpx;
  background: #ffffff;
  border-radius: 50%;
}

.live-time {
  margin-left: 16rpx;
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.66);
}

.live-title {
  display: block;
  margin-top: 12rpx;
  font-size: 29rpx;
  font-weight: 600;
  color: #ffffff;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.live-meta {
  display: block;
  margin-top: 8rpx;
  font-size: 21rpx;
  color: rgba(255, 255, 255, 0.66);
}

.live-all {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 136rpx;
  flex-shrink: 0;
  font-size: 21rpx;
  color: rgba(255, 255, 255, 0.86);
  border-left: 1rpx solid rgba(255, 255, 255, 0.14);
}

.live-arrow {
  margin-top: 4rpx;
  font-size: 32rpx;
  line-height: 1;
}

/* 学段 Tab */
.tabs {
  margin-top: 22rpx;
  white-space: nowrap;
}

.tab {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 64rpx;
  padding: 0 34rpx;
  margin-right: 16rpx;
  font-size: 26rpx;
  color: var(--text-2);
  background: #ffffff;
  border-radius: 999rpx;
  box-shadow: 0 4rpx 12rpx rgba(26, 34, 51, 0.04);
  transition: all 0.2s ease;
}

.tab--active {
  color: #ffffff;
  font-weight: 600;
  background: linear-gradient(135deg, #2b4acb, #5b7cfa);
  box-shadow: 0 10rpx 22rpx rgba(43, 74, 203, 0.28);
}

/* 列表 */
.list-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 36rpx 8rpx 20rpx;
}

.list-title {
  font-size: 34rpx;
  font-weight: 700;
}

.list-count {
  font-size: 22rpx;
  color: var(--text-3);
}

.list {
  display: flex;
  flex-direction: column;
}

.load-more {
  padding: 24rpx 0 10rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--text-3);
}

/* 骨架屏 */
.skeleton {
  display: flex;
  align-items: center;
  padding: 28rpx;
  margin-bottom: 22rpx;
  background: #ffffff;
  border-radius: 28rpx;
}

.skeleton-avatar {
  flex-shrink: 0;
  width: 112rpx;
  height: 112rpx;
  background: #eef1f6;
  border-radius: 32rpx;
}

.skeleton-body {
  flex: 1;
  margin-left: 24rpx;
}

.skeleton-line {
  height: 22rpx;
  margin-top: 14rpx;
  background: #eef1f6;
  border-radius: 8rpx;
}

.skeleton-line--lg {
  width: 44%;
  height: 28rpx;
  margin-top: 0;
}

.skeleton-line--sm {
  width: 30%;
}

.skeleton-avatar,
.skeleton-line {
  position: relative;
  overflow: hidden;
}

.skeleton-avatar::after,
.skeleton-line::after {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.7), transparent);
  animation: shimmer 1.4s infinite;
}

@keyframes shimmer {
  to {
    left: 100%;
  }
}
