/**login.wxss**/
.page {
  min-height: 100vh;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

.hero {
  position: relative;
  padding: 72rpx 48rpx 120rpx;
  overflow: hidden;
  color: #ffffff;
  background: linear-gradient(140deg, #2b4acb 0%, #4b6bfb 58%, #7a5af8 100%);
}

.hero-glow {
  position: absolute;
  top: -180rpx;
  right: -120rpx;
  width: 420rpx;
  height: 420rpx;
  background: rgba(255, 255, 255, 0.12);
  border-radius: 50%;
}

.hero-title {
  position: relative;
  display: block;
  font-size: 52rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
}

.hero-sub {
  position: relative;
  display: block;
  margin-top: 16rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

.form-card {
  position: relative;
  padding: 36rpx 36rpx 32rpx;
  margin: -80rpx 24rpx 0;
}

.tabs {
  display: flex;
  padding: 8rpx;
  margin-bottom: 32rpx;
  background: #f2f5fb;
  border-radius: 999rpx;
}

.tab {
  flex: 1;
  height: 68rpx;
  line-height: 68rpx;
  text-align: center;
  font-size: 28rpx;
  color: var(--text-2);
  border-radius: 999rpx;
}

.tab--active {
  color: var(--brand);
  font-weight: 600;
  background: #ffffff;
  box-shadow: 0 6rpx 16rpx rgba(26, 34, 51, 0.08);
}

.field {
  margin-bottom: 28rpx;
}

.label {
  display: block;
  margin-bottom: 12rpx;
  font-size: 24rpx;
  color: var(--text-2);
}

.input {
  height: 88rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  background: #f7f9fc;
  border: 1rpx solid transparent;
  border-radius: 18rpx;
}

.ph {
  color: #b6bfcc;
}

.error {
  display: block;
  margin-bottom: 18rpx;
  font-size: 24rpx;
  color: var(--danger);
}

.submit-btn {
  margin-top: 12rpx;
}

.divider {
  position: relative;
  height: 1rpx;
  margin: 40rpx 0 32rpx;
  background: var(--line);
}

.divider-text {
  position: absolute;
  top: 50%;
  left: 50%;
  padding: 0 20rpx;
  font-size: 22rpx;
  color: var(--text-3);
  background: #ffffff;
  transform: translate(-50%, -50%);
}

.btn-wx {
  height: 88rpx;
  line-height: 88rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #ffffff;
  background: #07c160;
  border-radius: 999rpx;
}

.btn-wx--hover {
  background: #06ad56;
}

.btn-wx[disabled] {
  color: rgba(255, 255, 255, 0.7);
  background: #8fdcae;
}

.wx-tip {
  display: block;
  margin-top: 14rpx;
  font-size: 22rpx;
  text-align: center;
  color: var(--text-3);
}

.demo {
  margin-top: 32rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--line);
}

.demo-title {
  display: block;
  margin-bottom: 14rpx;
  font-size: 22rpx;
  color: var(--text-3);
}

.demo-row {
  display: flex;
  flex-direction: column;
}

.demo-item {
  padding: 12rpx 18rpx;
  margin-bottom: 12rpx;
  font-size: 22rpx;
  color: var(--brand);
  background: var(--brand-light);
  border-radius: 12rpx;
}

.demo-item--admin {
  color: var(--accent);
  background: rgba(255, 138, 61, 0.1);
}

.tips {
  padding: 28rpx 48rpx 0;
  font-size: 22rpx;
  line-height: 1.7;
  text-align: center;
  color: var(--text-3);
}
