/**compare.wxss**/
.page {
  min-height: 100vh;
  padding: 24rpx 20rpx 60rpx;
}

.hint {
  padding: 8rpx 12rpx 22rpx;
  font-size: 22rpx;
  color: var(--text-3);
}

.table {
  overflow: hidden;
  background: #ffffff;
  border-radius: 28rpx;
  box-shadow: 0 8rpx 28rpx rgba(26, 34, 51, 0.06);
}

.row {
  display: flex;
  border-bottom: 1rpx solid var(--line);
}

.row:last-child {
  border-bottom: none;
}

.row--head {
  background: linear-gradient(160deg, #eef2ff 0%, #ffffff 100%);
}

.cell {
  flex: 1;
  min-width: 0;
  padding: 22rpx 16rpx;
  font-size: 23rpx;
  line-height: 1.6;
  color: var(--text-2);
  text-align: center;
  word-break: break-all;
}

.cell--label {
  flex: 0 0 120rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 600;
  color: var(--text-3);
  background: #f8fafd;
  text-align: center;
}

.cell--teacher {
  padding-top: 28rpx;
  padding-bottom: 24rpx;
}

.cell--value {
  border-left: 1rpx solid var(--line);
}

.avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 92rpx;
  height: 92rpx;
  margin: 0 auto 12rpx;
  overflow: hidden;
  border-radius: 26rpx;
}

.avatar-img {
  width: 100%;
  height: 100%;
}

.avatar-text {
  font-size: 36rpx;
  font-weight: 700;
  color: #ffffff;
}

.teacher-name {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--text);
}

.teacher-title {
  display: block;
  margin-top: 6rpx;
  font-size: 19rpx;
  line-height: 1.5;
  color: var(--text-3);
}

.tips {
  padding: 24rpx 12rpx 0;
  font-size: 21rpx;
  text-align: center;
  color: var(--text-3);
}

.loading {
  padding: 140rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: var(--text-3);
}
