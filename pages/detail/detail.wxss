/**detail.wxss**/
.page {
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

.hero {
  padding: 44rpx 40rpx 36rpx;
  background: linear-gradient(160deg, #eef2ff 0%, #ffffff 100%);
}

.hero-main {
  display: flex;
  align-items: center;
}

.avatar {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 160rpx;
  height: 160rpx;
  border: 6rpx solid #ffffff;
  border-radius: 48rpx;
  box-shadow: 0 12rpx 28rpx rgba(43, 74, 203, 0.2);
  overflow: hidden;
}

.avatar-img {
  width: 100%;
  height: 100%;
}

.avatar-text {
  color: #ffffff;
  font-size: 60rpx;
  font-weight: 700;
}

.hero-info {
  flex: 1;
  min-width: 0;
  margin-left: 30rpx;
}

.name-row {
  display: flex;
  align-items: center;
}

.name {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--text);
}

.stage-badge {
  margin-left: 16rpx;
  padding: 4rpx 16rpx;
  font-size: 20rpx;
  color: var(--brand);
  background: #ffffff;
  border-radius: 999rpx;
}

.title {
  display: block;
  margin-top: 10rpx;
  font-size: 25rpx;
  color: var(--text-2);
}

.tags {
  display: flex;
  flex-wrap: wrap;
  margin-top: 14rpx;
}

.tag {
  padding: 4rpx 16rpx;
  margin-right: 12rpx;
  font-size: 20rpx;
  line-height: 30rpx;
  color: var(--brand);
  background: rgba(255, 255, 255, 0.9);
  border-radius: 999rpx;
}

.stats {
  display: flex;
  align-items: center;
  margin-top: 36rpx;
  padding: 24rpx 0;
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(26, 34, 51, 0.05);
}

.stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-value {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--brand);
}

.stat-label {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: var(--text-3);
}

.stat-line {
  width: 1rpx;
  height: 44rpx;
  background: var(--line);
}

.body {
  padding: 28rpx 24rpx 0;
}

.block {
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.block-title {
  display: block;
  margin-bottom: 20rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text);
}

.intro {
  font-size: 27rpx;
  line-height: 1.8;
  color: var(--text-2);
}

.highlight {
  display: flex;
  align-items: flex-start;
  margin-bottom: 16rpx;
}

.highlight:last-child {
  margin-bottom: 0;
}

.highlight-dot {
  flex-shrink: 0;
  width: 14rpx;
  height: 14rpx;
  margin: 12rpx 16rpx 0 0;
  background: linear-gradient(135deg, var(--brand), #7a5af8);
  border-radius: 50%;
}

.highlight-text {
  flex: 1;
  font-size: 27rpx;
  line-height: 1.6;
  color: var(--text-2);
}

.course {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.course:last-child {
  padding-bottom: 0;
  border-bottom: none;
}

.course-index {
  flex-shrink: 0;
  width: 40rpx;
  height: 40rpx;
  margin-right: 20rpx;
  line-height: 40rpx;
  text-align: center;
  font-size: 22rpx;
  font-weight: 600;
  color: var(--brand);
  background: var(--brand-light);
  border-radius: 12rpx;
}

.course-name {
  font-size: 27rpx;
  color: var(--text-2);
}

/* 底部预约栏 */
.bottom-bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: center;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 -8rpx 24rpx rgba(26, 34, 51, 0.06);
}

.bottom-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  margin-left: 8rpx;
  min-width: 0;
}

.fav-btn {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 108rpx;
  height: 88rpx;
}

.fav-btn--hover {
  opacity: 0.7;
}

.fav-icon {
  font-size: 36rpx;
  line-height: 1;
  color: var(--text-3);
}

.fav-icon--on {
  color: #f04438;
}

.fav-text {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: var(--text-3);
}

.bottom-label {
  font-size: 20rpx;
  color: var(--text-3);
}

.bottom-name {
  margin-top: 4rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.book-btn {
  width: 240rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  color: #ffffff;
  background: linear-gradient(135deg, var(--brand), #5b7cfa);
  border-radius: 999rpx;
  box-shadow: 0 12rpx 26rpx rgba(43, 74, 203, 0.28);
}

.book-btn--hover {
  opacity: 0.9;
}

/* 骨架屏 */
.hero--skeleton {
  display: flex;
  align-items: center;
}

.sk-avatar {
  width: 160rpx;
  height: 160rpx;
  background: #e6ebf5;
  border-radius: 48rpx;
}

.sk-lines {
  flex: 1;
  margin-left: 30rpx;
}

.sk-line {
  height: 22rpx;
  margin-top: 16rpx;
  background: #e6ebf5;
  border-radius: 8rpx;
}

.sk-line--lg {
  width: 50%;
  height: 32rpx;
  margin-top: 0;
}

.sk-line--sm {
  width: 34%;
}
