# 复制为 .env 后按需修改：Windows 用 copy .env.example .env，macOS/Linux 用 cp
# 注意：.env 含密钥，已在 .gitignore 中排除，不要提交到仓库

PORT=3000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=teacher_mcn
DB_POOL=10

# 留空则自动使用进程内缓存；有密码时写成 redis://:密码@127.0.0.1:6379
REDIS_URL=

CACHE_TTL=60

# 上线前务必换成随机长字符串
JWT_SECRET=please-change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

LOG_LEVEL=info
LOG_RETENTION_DAYS=7

CORS_ORIGIN=*

# 微信小程序登录：在微信公众平台获取
WX_APPID=
WX_APPSECRET=
# 本地联调可设为 1，用 code=mock_xxx 走假微信登录；生产必须为 0
WX_MOCK=0
