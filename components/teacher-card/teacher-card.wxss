.t-card {
  display: flex;
  align-items: center;
  padding: 28rpx;
  margin-bottom: 22rpx;
  background: #ffffff;
  border-radius: 28rpx;
  box-shadow: 0 8rpx 28rpx rgba(26, 34, 51, 0.06);
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}

.t-card--hover {
  transform: scale(0.985);
  box-shadow: 0 4rpx 16rpx rgba(26, 34, 51, 0.08);
}

.t-avatar {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 112rpx;
  height: 112rpx;
  border-radius: 32rpx;
  overflow: hidden;
}

.t-avatar-img {
  width: 100%;
  height: 100%;
}

.t-avatar-text {
  color: #ffffff;
  font-size: 42rpx;
  font-weight: 700;
}

.t-body {
  flex: 1;
  min-width: 0;
  margin-left: 24rpx;
}

.t-top {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.t-name {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text);
}

.t-fans {
  flex-shrink: 0;
  margin-left: 16rpx;
  font-size: 22rpx;
  color: var(--accent);
  font-weight: 600;
}

.t-title {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--text-2);
}

.t-tags {
  display: flex;
  flex-wrap: wrap;
  margin-top: 14rpx;
}

.t-tag {
  padding: 4rpx 16rpx;
  margin-right: 12rpx;
  margin-bottom: 6rpx;
  font-size: 20rpx;
  line-height: 30rpx;
  color: var(--brand);
  background: var(--brand-light);
  border-radius: 999rpx;
}

.t-arrow {
  flex-shrink: 0;
  margin-left: 12rpx;
  color: #c4cbd8;
  font-size: 40rpx;
  line-height: 1;
}
