page {
  --brand: #2B4ACB;
  --brand-dark: #1E36A0;
  --brand-light: #EEF2FF;
  --accent: #FF8A3D;
  --text: #1A2233;
  --text-2: #5B6475;
  --text-3: #98A2B3;
  --bg: #F5F7FB;
  --card: #FFFFFF;
  --line: #EDF0F5;
  --success: #12B76A;
  --danger: #F04438;

  background: var(--bg);
  color: var(--text);
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', 'PingFang SC',
    'Microsoft YaHei', sans-serif;
  font-size: 28rpx;
  -webkit-font-smoothing: antialiased;
}

view,
text,
input,
textarea,
button {
  box-sizing: border-box;
}

button {
  padding: 0;
  margin: 0;
  background: transparent;
  font-size: inherit;
  line-height: inherit;
  border-radius: 0;
}

button::after {
  border: none;
}

.card {
  background: var(--card);
  border-radius: 28rpx;
  box-shadow: 0 8rpx 28rpx rgba(26, 34, 51, 0.06);
}

.btn-primary {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 92rpx;
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  background: linear-gradient(135deg, var(--brand), #5B7CFA);
  border-radius: 999rpx;
  box-shadow: 0 14rpx 30rpx rgba(43, 74, 203, 0.28);
}

.btn-primary--hover {
  opacity: 0.9;
  transform: translateY(1rpx);
}

.btn-ghost {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  color: var(--brand);
  font-size: 30rpx;
  font-weight: 500;
  background: var(--brand-light);
  border-radius: 999rpx;
}

.section-title {
  display: flex;
  align-items: center;
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text);
}

.ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.safe-bottom {
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}
